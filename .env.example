# Contact form delivery.
# When these are unset the enquiry is logged server-side and the form tells the
# visitor it was not emailed, rather than silently dropping the lead.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fintwiz Wealth <noreply@fintwizwealth.com>"

# Where general enquiries land.
CONTACT_TO=

# Optional. Grievance submissions go here instead of CONTACT_TO when set.
CONTACT_GRIEVANCE_TO=
